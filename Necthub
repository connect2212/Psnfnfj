local bv, bg, flyConn
local ControlModule = nil

task.spawn(function()
    pcall(function()
        ControlModule = require(LP:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)
end)

local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

local function startFly()
    stopFly()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local h = char:WaitForChild("Humanoid")
    local r = char:WaitForChild("HumanoidRootPart")

    h.PlatformStand = true
    
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = r

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9000
    bg.CFrame = r.CFrame
    bg.Parent = r

    flyConn = RunService.RenderStepped:Connect(function()
        if not fly or not char.Parent or not h or not r then
            stopFly()
            return
        end
        bg.CFrame = Cam.CFrame
        
        local moveVector = Vector3.zero
        if ControlModule then
            moveVector = ControlModule:GetMoveVector()
        end
        
        local velocity = Vector3.zero
        if moveVector.Magnitude > 0 then
            velocity = (Cam.CFrame.LookVector * -moveVector.Z + Cam.CFrame.RightVector * moveVector.X) * spd
        end
        bv.Velocity = velocity
    end)
end

